#!/bin/sh

xrdb -merge /home/eli/.Xresources

export MOZ_USE_XINPUT2=1

feh --bg-tile /home/eli/Pictures/bluecircuit.png

dunst &
picom &

xinput set-prop 12 "libinput Accel Speed" 0.22
xinput set-prop 12 "libinput Natural Scrolling Enabled" 1
xinput set-prop 12 "libinput Click Method Enabled" {1, 1}
xinput set-prop 12 "libinput Disable While Typing Enabled" 0

.dwm/autostart.sh &

pactl load-module module-switch-on-connect

xrandr --output eDP --gamma 1.22:1.22:1.22

exec dbus-run-session -- dwm
